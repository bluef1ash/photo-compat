{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "照片适配助手",
  "mainBinaryName": "photo-compat",
  "version": "0.1.0",
  "identifier": "com.photocompat.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ./frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ./frontend run build:release",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "照片适配助手",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
