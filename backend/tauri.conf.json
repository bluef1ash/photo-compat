{
  "$schema": "../gen/schemas/desktop-schema.json",
  "build": {
    "beforeDevCommand": "pnpm --dir ./frontend run dev",
    "beforeBuildCommand": "pnpm --dir ./frontend run build:release",
    "devPath": "http://localhost:1420",
    "distDir": "../frontend/dist"
  },
  "package": {
    "productName": "photo-compat",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      },
      "path": {
        "all": true
      },
      "protocol": {
        "asset": true,
        "assetScope": [
          "**"
        ]
      },
      "window": {
        "all": false,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "close": true,
        "startDragging": true
      }
    },
    "windows": [
      {
        "title": "照片适配助手",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "fileDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "bundle": {
      "active": true,
      "identifier": "com.photocompat.app",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "GraphicsAndDesign",
      "windows": {
        "nsis": {
          "template": "templates/installer.nsi"
        }
      },
      "deb": {
        "desktopTemplate": "templates/photo-compat.desktop"
      },
      "rpm": {
        "desktopTemplate": "templates/photo-compat.desktop"
      }
    }
  }
}
